@page "{id:int}"
@model PostModel
@{
    ViewData["Title"] = "Post";
}

<p><a asp-page="/Index">&larr; Back to Feed</a></p>

@if (Model.MainPost is not null)
{
    var post = Model.MainPost;
    <div class="post-card post-card-main">
        <div class="post-header">
            <a class="post-avatar-row profile-link" asp-page="/UserProfile" asp-route-username="@post.AuthorUsername">
                <partial name="_Avatar" model='new Simple_Chat.Data.AvatarViewModel(post.AuthorUsername, post.AuthorAvatarUrl, "avatar-sm")' />
                <span class="post-author">@@@post.AuthorUsername</span>
            </a>
            <span class="post-time">@post.CreatedAt.ToLocalTime().ToString("MMM d, HH:mm")</span>
        </div>
        <div class="post-content">@post.Content</div>

        @if (!string.IsNullOrEmpty(post.MediaUrl))
        {
            <div class="post-media">
                @if (post.MediaType == "video")
                {
                    <video controls src="@post.MediaUrl"></video>
                }
                else
                {
                    <img src="@post.MediaUrl" alt="attached media" />
                }
            </div>
        }

        <div class="post-actions">
            <span class="post-action">💬 @post.ReplyCount</span>

            <form method="post" asp-page-handler="ToggleRepost" class="inline-form">
                <input type="hidden" name="postId" value="@post.Id" />
                <input type="hidden" name="id" value="@post.Id" />
                <button type="submit" class="post-action @(post.IsRepostedByMe ? "active-repost" : "")">
                    🔁 @post.RepostCount
                </button>
            </form>

            <form method="post" asp-page-handler="ToggleLike" class="inline-form">
                <input type="hidden" name="postId" value="@post.Id" />
                <input type="hidden" name="id" value="@post.Id" />
                <button type="submit" class="post-action @(post.IsLikedByMe ? "active-like" : "")">
                    @(post.IsLikedByMe ? "❤️" : "🤍") @post.LikeCount
                </button>
            </form>
        </div>
    </div>

    <div class="compose-box reply-box">
        <form method="post" asp-page-handler="Reply" enctype="multipart/form-data">
            <input type="hidden" name="id" value="@post.Id" />
            <textarea asp-for="ReplyContent" placeholder="Post your reply" maxlength="500"></textarea>
            <div class="compose-actions">
                <label class="media-attach-btn">
                    📎 <input type="file" name="MediaFile" accept="image/*,video/*" style="display:none;" onchange="this.parentElement.nextElementSibling.querySelector('.file-name').textContent = this.files[0] ? this.files[0].name : ''" />
                </label>
                <span class="compose-spacer"><span class="file-name"></span></span>
                <button type="submit">Reply</button>
            </div>
        </form>
    </div>

    <div class="feed">
        @foreach (var reply in Model.Replies)
        {
            <div class="post-card">
                <div class="post-header">
                    <a class="post-avatar-row profile-link" asp-page="/UserProfile" asp-route-username="@reply.AuthorUsername">
                        <partial name="_Avatar" model='new Simple_Chat.Data.AvatarViewModel(reply.AuthorUsername, reply.AuthorAvatarUrl, "avatar-sm")' />
                        <span class="post-author">@@@reply.AuthorUsername</span>
                    </a>
                    <span class="post-time">@reply.CreatedAt.ToLocalTime().ToString("MMM d, HH:mm")</span>
                </div>
                <div class="post-content">@reply.Content</div>

                @if (!string.IsNullOrEmpty(reply.MediaUrl))
                {
                    <div class="post-media">
                        @if (reply.MediaType == "video")
                        {
                            <video controls src="@reply.MediaUrl"></video>
                        }
                        else
                        {
                            <img src="@reply.MediaUrl" alt="attached media" />
                        }
                    </div>
                }

                <div class="post-actions">
                    <a class="post-action" asp-page="/Post" asp-route-id="@reply.Id">💬 @reply.ReplyCount</a>

                    <form method="post" asp-page-handler="ToggleRepost" class="inline-form">
                        <input type="hidden" name="postId" value="@reply.Id" />
                        <input type="hidden" name="id" value="@post.Id" />
                        <button type="submit" class="post-action @(reply.IsRepostedByMe ? "active-repost" : "")">
                            🔁 @reply.RepostCount
                        </button>
                    </form>

                    <form method="post" asp-page-handler="ToggleLike" class="inline-form">
                        <input type="hidden" name="postId" value="@reply.Id" />
                        <input type="hidden" name="id" value="@post.Id" />
                        <button type="submit" class="post-action @(reply.IsLikedByMe ? "active-like" : "")">
                            @(reply.IsLikedByMe ? "❤️" : "🤍") @reply.LikeCount
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}

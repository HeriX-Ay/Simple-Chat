@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}


        
        <div class="content-card">
            <h1>@ViewData["Title"]</h1>
            <p class="meta-date">🔒 Last updated: July 1, 2026</p>
            <p class="body-text">
                Welcome to Simple Chat. Your privacy is important to us. This Privacy Policy
                explains how we collect, use, and protect your information.
            </p>
        

        
            <h2>📌 1. Information We Collect</h2>
            <p>We may collect the following information:</p>
            <ul>
                <li>Username (when you enter it in the chat)</li>
                <li>Messages you send through the application</li>
                <li>Basic technical data such as browser type or device (if applicable)</li>
            </ul>
            
                <img src="/Images/Image1.png" class="responsive-policy-img" alt="Privacy policy on data we collect" />
            
        

        
            <h2>📌 2. How We Use Your Information</h2>
            <p>We use your information to:</p>
            <ul>
                <li>Provide and operate the chat service</li>
                <li>Display messages in the chat</li>
                <li>Improve user experience</li>
            </ul>
           
                <img src="/Images/Image2.png" class="responsive-policy-img" alt="How we use your data." />
           
        
            <h2>📌 3. Data Storage</h2>
            <p>
                Your username is tied to your signed-in session. Messages are processed by the
                server to deliver them to other users. We do not store personal data permanently
                unless stated otherwise.
            </p>
           
                <img src="/Images/Image3.png" class="responsive-policy-img" alt="How we use your data." />
           
            <h2>📌 4. Sharing Information</h2>
            <p>We do not sell, trade, or share your personal information with third parties.</p>
            
                <img src="/Images/Image4.png" class="responsive-policy-img" alt="How we use your data." />
         
            <h2>📌 5. Security</h2>
            <p>
                We take reasonable measures to protect your data, but no system is 100% secure,
                and we cannot guarantee absolute security.
            </p>
           
                <img src="/Images/Image5.png" class="responsive-policy-img" alt="How we use your data." />
            

        
            <h2>📌 6. Your Rights</h2>
            <p>You have the right to:</p>
            <ul>
                <li>Request removal of your account</li>
                <li>Stop using the service at any time</li>
            </ul>
            
                <img src="/Images/Image6.png" class="responsive-policy-img" alt="How we use your data." />
        

            <h2>📌 7. Changes to This Policy</h2>
            <p>We may update this Privacy Policy at any time. Changes will be posted on this page.</p>
            
                <img src="/Images/Image7.png" class="responsive-policy-img" alt="How we use your data." />
        

        
            <h2>📌 8. Contact</h2>
            <p>
                Email:
                <a href="mailto:heritage.ojo@derventioeducation.com" class="contact-link">heritage.ojo@derventioeducation.com</a>
            </p>
        </div>